# Flash runtime library, part 0b: the Windows platform layer.
#
# Windows has no stable system-call interface, so on Windows (`__os() == 2`) the runtime calls
# functions of kernel32.dll through the executable's import table (`__winapi(slot, args...)`;
# the slot numbers are the order of `IMPORTS` in native/pe.rs):
#   0 GetStdHandle      1 WriteFile        2 ReadFile          3 CreateFileA
#   4 CloseHandle       5 VirtualAlloc     6 VirtualFree       7 ExitProcess
#   8 QueryPerformanceCounter   9 QueryPerformanceFrequency   10 Sleep
#  11 GetFileAttributesA        12 DeleteFileA                 13 GetCommandLineA
#  14 GetEnvironmentStringsA    15 GetLastError
#  16 CreateThread     17 WaitForSingleObject      18 SwitchToThread   (used by thread.flash)
# Everything returns a negative errno-style number on failure (the Linux numbering, as the
# portable part of the runtime expects). Files are opened with the ANSI functions, so paths are
# interpreted in the system code page. A "file descriptor" of 0, 1, 2 is a standard stream; any
# other number is the Windows handle itself.

fn win_handle(fd: Int) -> Int:
    if fd <= 2:
        return __winapi(0, -10 - fd, 0, 0, 0, 0, 0, 0)
    return fd

fn win_write(fd: Int, buf: Int, n: Int) -> Int:
    out = __state() + 1520
    __poke(out, 0, 0)
    ok = __winapi(1, win_handle(fd), buf, n, out, 0, 0, 0)
    if (ok & 4294967295) == 0:
        return -5
    return __peek(out, 0) & 4294967295

fn win_read(fd: Int, buf: Int, n: Int) -> Int:
    out = __state() + 1520
    __poke(out, 0, 0)
    ok = __winapi(2, win_handle(fd), buf, n, out, 0, 0, 0)
    if (ok & 4294967295) == 0:
        err = __winapi(15, 0, 0, 0, 0, 0, 0, 0) & 4294967295
        if err == 109:
            return 0
        return -5
    return __peek(out, 0) & 4294967295

# mode: 0 = read, 1 = write (create, truncate), 2 = append (create)
fn win_open(path: Int, mode: Int) -> Int:
    access = 2147483648
    disposition = 3
    if mode == 1:
        access = 1073741824
        disposition = 2
    elif mode == 2:
        access = 4
        disposition = 4
    h = __winapi(3, path, access, 3, 0, disposition, 128, 0)
    if h == -1:
        err = __winapi(15, 0, 0, 0, 0, 0, 0, 0) & 4294967295
        if err == 2 or err == 3:
            return -2
        if err == 5:
            return -13
        if err == 80 or err == 183:
            return -17
        return -5
    return h

fn win_close(fd: Int):
    __winapi(4, fd, 0, 0, 0, 0, 0, 0)

fn win_mmap(n: Int) -> Int:
    return __winapi(5, 0, n, 12288, 4, 0, 0, 0)

fn win_munmap(p: Int):
    __winapi(6, p, 0, 32768, 0, 0, 0, 0)

fn win_access(path: Int) -> Int:
    a = __winapi(11, path, 0, 0, 0, 0, 0, 0) & 4294967295
    if a == 4294967295:
        return -2
    return 0

fn win_unlink(path: Int) -> Int:
    ok = __winapi(12, path, 0, 0, 0, 0, 0, 0) & 4294967295
    if ok == 0:
        return -2
    return 0

fn win_exit(code: Int):
    __winapi(7, code, 0, 0, 0, 0, 0, 0)

fn win_clock_ns() -> Int:
    p = __state() + 1500
    __winapi(8, p, 0, 0, 0, 0, 0, 0)
    __winapi(9, p + 8, 0, 0, 0, 0, 0, 0)
    c = __peek(p, 0)
    f = __peek(p, 8)
    return (c / f) * 1000000000 + (c % f) * 1000000000 / f

fn win_sleep_ms(ms: Int):
    __winapi(10, ms, 0, 0, 0, 0, 0, 0)

# Builds the block the portable runtime expects at process start (as the Linux kernel lays it out
# on the stack): [argc][argv ... 0][envp ... 0], from the command line and environment block.
# The command line is split with the usual Windows rules (quotes group, backslashes before a
# quote are halved).
fn win_startup() -> Int:
    cmd = __winapi(13, 0, 0, 0, 0, 0, 0, 0)
    env = __winapi(14, 0, 0, 0, 0, 0, 0, 0)
    clen = cstr_len(cmd)
    elen = 0
    ecount = 0
    while __peek8(env, elen) != 0:
        while __peek8(env, elen) != 0:
            elen += 1
        elen += 1
        ecount += 1
    maxargs = clen / 2 + 2
    ptrs = 8 * (maxargs + ecount + 4)
    buf = win_mmap(ptrs + clen + 16)
    out = buf + ptrs
    argc = 0
    i = 0
    while True:
        while __peek8(cmd, i) == 32 or __peek8(cmd, i) == 9:
            i += 1
        if __peek8(cmd, i) == 0:
            break
        __poke(buf + 8, argc * 8, out)
        argc += 1
        inq = False
        while True:
            c = __peek8(cmd, i)
            if c == 0:
                break
            if (c == 32 or c == 9) and not inq:
                break
            if c == 34:
                inq = not inq
                i += 1
                continue
            if c == 92:
                nb = 0
                while __peek8(cmd, i) == 92:
                    nb += 1
                    i += 1
                if __peek8(cmd, i) == 34:
                    k = 0
                    while k < nb / 2:
                        __poke8(out, 0, 92)
                        out += 1
                        k += 1
                    if nb % 2 == 1:
                        __poke8(out, 0, 34)
                        out += 1
                    else:
                        inq = not inq
                    i += 1
                else:
                    k = 0
                    while k < nb:
                        __poke8(out, 0, 92)
                        out += 1
                        k += 1
                continue
            __poke8(out, 0, c)
            out += 1
            i += 1
        __poke8(out, 0, 0)
        out += 1
    __poke(buf, 0, argc)
    __poke(buf + 8, argc * 8, 0)
    envp = buf + 8 * (argc + 2)
    j = 0
    e = 0
    while e < ecount:
        __poke(envp, e * 8, env + j)
        while __peek8(env, j) != 0:
            j += 1
        j += 1
        e += 1
    __poke(envp, ecount * 8, 0)
    return buf
