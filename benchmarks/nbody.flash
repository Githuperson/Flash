# Systems workload: n-body gravitational simulation (5 bodies, 5 million steps).
struct Body:
    x: Float
    y: Float
    z: Float
    vx: Float
    vy: Float
    vz: Float
    mass: Float

fn advance(mut bodies: List[Body], dt: Float):
    n = len(bodies)
    for i in 0..n:
        for j in (i + 1)..n:
            dx = bodies[i].x - bodies[j].x
            dy = bodies[i].y - bodies[j].y
            dz = bodies[i].z - bodies[j].z
            d2 = dx * dx + dy * dy + dz * dz
            mag = dt / (d2 * sqrt(d2))
            mi = bodies[i].mass
            mj = bodies[j].mass
            bodies[i].vx = bodies[i].vx - dx * mj * mag
            bodies[i].vy = bodies[i].vy - dy * mj * mag
            bodies[i].vz = bodies[i].vz - dz * mj * mag
            bodies[j].vx = bodies[j].vx + dx * mi * mag
            bodies[j].vy = bodies[j].vy + dy * mi * mag
            bodies[j].vz = bodies[j].vz + dz * mi * mag
    for i in 0..n:
        bodies[i].x = bodies[i].x + dt * bodies[i].vx
        bodies[i].y = bodies[i].y + dt * bodies[i].vy
        bodies[i].z = bodies[i].z + dt * bodies[i].vz

fn energy(bodies: List[Body]) -> Float:
    e = 0.0
    n = len(bodies)
    for i in 0..n:
        e = e + 0.5 * bodies[i].mass * (bodies[i].vx * bodies[i].vx + bodies[i].vy * bodies[i].vy + bodies[i].vz * bodies[i].vz)
        for j in (i + 1)..n:
            dx = bodies[i].x - bodies[j].x
            dy = bodies[i].y - bodies[j].y
            dz = bodies[i].z - bodies[j].z
            e = e - bodies[i].mass * bodies[j].mass / sqrt(dx * dx + dy * dy + dz * dz)
    return e

pi = 3.141592653589793
solar = 4.0 * pi * pi
dpy = 365.24
bodies: List[Body] = []
append(bodies, Body(x=0.0, y=0.0, z=0.0, vx=0.0, vy=0.0, vz=0.0, mass=solar))
append(bodies, Body(x=4.84143144246472090, y=-1.16032004402742839, z=-0.103622044471123109, vx=0.00166007664274403694 * dpy, vy=0.00769901118419740425 * dpy, vz=-0.0000690460016972063023 * dpy, mass=0.000954791938424326609 * solar))
append(bodies, Body(x=8.34336671824457987, y=4.12479856412430479, z=-0.403523417114321381, vx=-0.00276742510726862411 * dpy, vy=0.00499852801234917238 * dpy, vz=0.0000230417297573763929 * dpy, mass=0.000285885980666130812 * solar))
append(bodies, Body(x=12.8943695621391310, y=-15.1111514016986312, z=-0.223307578892655734, vx=0.00296460137564761618 * dpy, vy=0.00237847173959480950 * dpy, vz=-0.0000296589568540237556 * dpy, mass=0.0000436624404335156298 * solar))
append(bodies, Body(x=15.3796971148509165, y=-25.9193146099879641, z=0.179258772950371181, vx=0.00268067772490389322 * dpy, vy=0.00162824170038242295 * dpy, vz=-0.0000951592254519715870 * dpy, mass=0.0000515138902046611451 * solar))

# offset the sun's momentum
px = 0.0
py = 0.0
pz = 0.0
for i in 0..len(bodies):
    px = px + bodies[i].vx * bodies[i].mass
    py = py + bodies[i].vy * bodies[i].mass
    pz = pz + bodies[i].vz * bodies[i].mass
bodies[0].vx = -px / solar
bodies[0].vy = -py / solar
bodies[0].vz = -pz / solar

say(int(energy(bodies) * 1000000000.0))
for step in 0..5000000:
    advance(bodies, 0.01)
say(int(energy(bodies) * 1000000000.0))
