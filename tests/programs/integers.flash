# Integer types, wrapping arithmetic, conversions
a: u8 = 250
b: u8 = 10
say(a + b)  # wraps: 4
c: i32 = 2147483647
say(c + 1)  # wraps: -2147483648
d: i8 = -128
say(d - 1)  # 127
say(u8(300))  # 44
say(i8(200))  # -56
say(int(3.99), int(-3.99))
say(int(1e30))  # saturates
say(u8(1000.5))  # saturates to 255
say(float(7) / 2.0)
big = 9223372036854775807
say(big + 1)  # wraps to minimum
say(-9223372036854775807 - 1)
x = -9223372036854775807 - 1
say(x / -1)  # defined: wraps
say(x % -1)
say(-7 / 2, -7 % 2, 7 / -2, 7 % -2)
say(1 << 62, -16 >> 2)
w: u32 = 4000000000
say(w >> 4, w / 3, w % 7)
say(u64(18446744073709551615) / 2)
say(5 < 7, 5 > 7, 5 <= 5, 5 >= 6, 5 == 5, 5 != 5)
y: u8 = 200
z: u8 = 100
say(y > z, y < z)
say(abs(-5), abs(2.5), min(3, 9), max(3, 9), min(2.5, 1.5))
say(sqrt(16.0), floor(2.7), ceil(2.2), pow(2.0, 10.0))
say(0xFF, 0b1010, 1_000_000)
