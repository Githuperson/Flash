# Function values: named functions, lambdas, captured numbers
fn double(x: Int) -> Int:
    return x * 2

fn apply(f: Fn(Int) -> Int, x: Int) -> Int:
    return f(x)

fn twice(f: Fn(Int) -> Int, x: Int) -> Int:
    return f(f(x))

fn make_adder(n: Int) -> Fn(Int) -> Int:
    return lambda x: x + n

fn map_ints(items: List[Int], f: Fn(Int) -> Int) -> List[Int]:
    out: List[Int] = []
    for x in items:
        append(out, f(x))
    return out

fn keep(items: List[Int], pred: Fn(Int) -> Bool) -> List[Int]:
    out: List[Int] = []
    for x in items:
        if pred(x):
            append(out, x)
    return out

fn each(items: List[String], f: Fn(String)):
    for s in items:
        f(s)

struct Op:
    name: String
    run: Fn(Int, Int) -> Int

say(apply(double, 21))
say(twice(lambda x: x * 3, 2))
add5 = make_adder(5)
say(add5(10))
say(twice(add5, 0))
limit = 3
say(map_ints([1, 2, 3, 4], lambda x: x * x))
say(keep([1, 2, 3, 4, 5, 6], lambda x: x > limit))
each(["a", "b"], lambda s: say(f"item {s}"))
ops = [Op(name="add", run=lambda a, b: a + b), Op(name="mul", run=lambda a, b: a * b)]
for op in ops:
    say(f"{op.name}: {op.run(6, 7)}")
g: Fn(Float) -> Float = lambda v: v / 2.0
say(g(5.0))
